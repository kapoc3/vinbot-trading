# ==============================================================================
# VINBOT ALPACA PROFILE (.env.alpaca.example) -> Container: vinbot-alpaca
# Arquitectura para US Equities (Stocks, ETFs) y Cripto sin comisiones
# Copiar con: cp .env.alpaca.example .env.alpaca
# ==============================================================================

# --- 1. Broker Backend ---
BROKER_BACKEND=alpaca
ENABLE_ALPACA=True
ALPACA_ENV=paper  # 'paper' para simulación sin riesgo o 'live' para producción
ALPACA_API_KEY=your_alpaca_api_key_here
ALPACA_SECRET_KEY=your_alpaca_secret_key_here
ALPACA_PAPER_BASE_URL=https://paper-api.alpaca.markets
ALPACA_LIVE_BASE_URL=https://api.alpaca.markets
ALPACA_DATA_URL=https://data.alpaca.markets
ALPACA_TRADING_SYMBOLS="SPY,QQQ,NVDA,AAPL,MSFT"
ALPACA_TIMEOUT_SECONDS=15.0

# --- 2. Símbolos Operados y Proyecto ---
TRADING_SYMBOLS=SPY,QQQ,NVDA,AAPL
PROJECT_NAME="VinBot Alpaca Equities"
API_V1_STR="/api/v1"
LOG_LEVEL=INFO
DATABASE_PATH=data/vinbot_alpaca.db

# --- 3. Estrategia y Parámetros Técnicos ---
TRADING_STRATEGY=Auto
RSI_OVERSOLD=35.0
RSI_OVERBOUGHT=65.0

# --- 4. Gestión de Riesgo (Bracket Orders Nativas) ---
STOP_LOSS_PCT=2.0
TAKE_PROFIT_PCT=5.0
MAX_DAILY_LOSS_PCT=2.0
MOVE_SL_TO_BE_ON_TP1=True

# --- 5. Dimensionamiento y Capital ---
ENABLE_DYNAMIC_SIZING=True
ALLOCATED_CAPITAL=1000.0
FIXED_ORDER_VALUE_USDT=50.0
RISK_PER_TRADE_PCT=1.0

# --- 6. Filtros Avanzados y ML ---
ENABLE_VOLUME_CONFIRMATION=True
ENABLE_TRAILING_STOP=True
ML_ENABLED=True
ML_AUTO_TRAIN_ENABLED=True
ML_RETRAIN_INTERVAL_HOURS=12

# --- 7. Base de Datos & Dashboard ---
DASHBOARD_USERNAME=admin
DASHBOARD_PASSWORD=admin
SECRET_KEY=change_this_secret_key_for_alpaca
OTLP_ENDPOINT=http://tempo:4317
PROMETHEUS_METRICS_PATH=/metrics
