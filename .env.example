# ==============================================================================
# VINBOT TRADING CORE - TEMPLATE DE VARIABLES DE ENTORNO (.env.example)
# ==============================================================================
# Para desplegar con Docker Compose, se requieren 4 archivos en la raíz:
#   1. .env          -> Configuración base y desarrollo local
#   2. .env.classic  -> Contenedor `bot-classic` (Estrategia Auto / Swing)
#   3. .env.scalper  -> Contenedor `bot-scalper` (Operativa rápida / Scalping)
#   4. .env.grid     -> Contenedor `bot-grid` (Grid Trading para rangos)
#
# Copia este archivo para inicializar los 4 perfiles:
#   cp .env.example .env && cp .env.example .env.classic && cp .env.example .env.scalper && cp .env.example .env.grid
# ==============================================================================

# --- 1. Credenciales y Entorno de Binance ---
BINANCE_API_KEY=your_api_key_here
BINANCE_SECRET_KEY=your_binance_secret_key
# Opciones de entorno: prod | testnet | mock
BINANCE_ENV=prod
USE_TESTNET=False
TRADING_SYMBOLS=BTCUSDT,ETHUSDT

# --- 2. Enrutamiento Inteligente (Smart Split-Routing & Static IP Proxies) ---
# Lista separada por comas de proxies HTTP estáticos (ej. Webshare Direct Connection en Europa).
# IMPORTANTE: No usar IPs de EE. UU. (bloqueadas con HTTP 451 por Binance).
# Orden recomendado por latencia verificada: Madrid -> Varsovia -> Londres
BINANCE_PROXY_URLS="http://user:password@64.137.96.74:6641,http://user:password@84.247.60.125:6095,http://user:password@45.38.107.97:6014"
# Si es True, solo las peticiones firmadas (órdenes/balance) usan el proxy fijo (<5 MB/mes)
# y los WebSockets públicos van directo por el ISP local con auto-reconexión.
BINANCE_PROXY_SIGNED_ONLY=True
WS_PING_INTERVAL=20
WS_PING_TIMEOUT=10
WS_READ_TIMEOUT=45

# --- 3. Motor de Estrategias ---
# Opciones: Auto | RsiOnly | RsiWithDivergence | BollingerBands | MacdMaCross | Breakout
TRADING_STRATEGY=Auto
RSI_PERIOD=14
RSI_OVERSOLD=30.0
RSI_OVERBOUGHT=70.0
BREAKOUT_VOLUME_MULTIPLIER=1.5

# --- 4. Machine Learning Local y Auto-Trainer ---
# Entrena localmente modelos RandomForest con validación Walk-Forward sin Data Leakage
ML_ENABLED=True
ML_AUTO_TRAIN_ENABLED=True
ML_RETRAIN_INTERVAL_HOURS=12
ML_MODEL_PATH=data/ml_models
ML_CONFIDENCE_THRESHOLD=0.5
ML_TRAIN_THRESHOLD_PCT=2.0
ML_TRAIN_HORIZON=10

# --- 5. Confluencia Multi-Timeframe ---
MULTI_TF_ENABLED=False
ACTIVE_TIMEFRAMES=1m,15m,1h
MAX_CANDLES_PER_TF=500
MIN_CONFLUENCE_LEVEL=MEDIA
ALLOW_LOW_CONFLUENCE_TRADES=False

# --- 6. Gestión de Riesgo y Position Sizing ---
ENABLE_DYNAMIC_SIZING=True
ALLOCATED_CAPITAL=1000.0
RISK_PER_TRADE_PCT=1.0
FIXED_ORDER_VALUE_USDT=10.0
STOP_LOSS_PCT=2.0
TAKE_PROFIT_PCT=5.0
MAX_DAILY_LOSS_PCT=2.0

# Salidas Parciales y Trailing Take Profit
PARTIAL_TP_LEVELS="1.0:30,2.0:30,3.0:40"
MOVE_SL_TO_BE_ON_TP1=True
ENABLE_DYNAMIC_PARTIAL_TP=True

# Protección de Comisiones (Net Fee Protection & Break-Even Real)
BINANCE_FEE_PCT=0.1
USE_BNB_FEE_DISCOUNT=True
ACCOUNT_FOR_FEES_IN_TP=True
MIN_PROFIT_USD=0.0
ENABLE_TRAILING_STOP=True
ATR_TRAILING_MULTIPLIER=3.0
ENABLE_TRAILING_TP=True
TRAILING_TP_ATR_MULTIPLIER=2.0
TRAILING_TP_ACTIVATION_PCT=1.5
ENABLE_TIME_EXIT=True
MAX_HOLD_HOURS=4
TIME_EXIT_COOLDOWN_MINUTES=15
ENABLE_SIGNAL_STRENGTH_EXIT=True

# --- 7. Filtros Globales (Capa de Veto) ---
ENABLE_VOLUME_CONFIRMATION=True
VWAP_PERIOD=50
ENABLE_BTC_DIRECTIONAL_FILTER=True
BTC_DIRECTION_EMA=200
ENABLE_RELATIVE_STRENGTH_FILTER=True
RS_LOOKBACK_PERIOD=14

# --- 8. Market Scanner Dinámico (Arquitectura Core-Satellite 70/30) ---
ENABLE_MARKET_SCANNER=False
SCANNER_INTERVAL_HOURS=2
SCANNER_MIN_VOLUME_USD=10000000.0
SCANNER_TOP_N=3
SCANNER_WINDOW_SIZE=1h
SCANNER_EXCLUDE_SYMBOLS="BTCUSDC,ETHUSDC,SOLUSDC,BNBUSDC,BTCUSDT,ETHUSDT,SOLUSDT,BNBUSDT"

# --- 9. Grid Bot (Específico para .env.grid) ---
ENABLE_GRID_BOT=False
GRID_SYMBOL=SOLUSDT
GRID_LOWER_PRICE=100.0
GRID_UPPER_PRICE=150.0
GRID_GRID_COUNT=10
GRID_SPACING_PCT=1.0

# --- 9. Paper Trading (Simulación en Vivo) ---
PAPER_TRADING_ENABLED=False
PAPER_INITIAL_BALANCE=10000.0
PAPER_SLIPPAGE=0.001
PAPER_COMMISSION=0.001

# --- 10. Notificaciones Telegram ---
TELEGRAM_BOT_TOKEN=your_telegram_bot_token
TELEGRAM_CHAT_ID=your_telegram_chat_id
ENABLE_PERIODIC_REPORTS=False
REPORT_INTERVAL_SECONDS=21600

# --- 11. Base de Datos, Dashboard y Observabilidad ---
PROJECT_NAME="VinBot Trading Core"
API_V1_STR="/api/v1"
LOG_LEVEL=INFO
DATABASE_PATH=data/vinbot.db
DB_HOST=db
DB_PORT=5432
DB_USER=vinbot
DB_PASSWORD=vinbotpass
DB_NAME=vinbot_db
DASHBOARD_USERNAME=admin
DASHBOARD_PASSWORD=admin
SECRET_KEY=change_this_secret_key_in_production
OTLP_ENDPOINT=http://tempo:4317
PROMETHEUS_METRICS_PATH=/metrics
