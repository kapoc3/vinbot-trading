# ==============================================================================
# VINBOT SCALPER PROFILE (.env.scalper.example) -> Container: vinbot-scalper
# Copy with: cp .env.scalper.example .env.scalper
# ==============================================================================
BINANCE_API_KEY=your_api_key_here
BINANCE_SECRET_KEY=your_binance_secret_key
BINANCE_ENV=prod
USE_TESTNET=False
TRADING_SYMBOLS=BTCUSDT,ETHUSDT

PROJECT_NAME="VinBot Scalper"
API_V1_STR="/api/v1"
LOG_LEVEL=INFO
TRADING_STRATEGY=Auto
RSI_OVERSOLD=30.0
RSI_OVERBOUGHT=70.0

STOP_LOSS_PCT=1.5
TAKE_PROFIT_PCT=3.0
MAX_DAILY_LOSS_PCT=2.0
MAX_HOLD_HOURS=2
PARTIAL_TP_LEVELS="1.0:50,2.0:50"
MOVE_SL_TO_BE_ON_TP1=True

ENABLE_DYNAMIC_SIZING=True
ALLOCATED_CAPITAL=1000.0
RISK_PER_TRADE_PCT=1.0

ENABLE_VOLUME_CONFIRMATION=True
ENABLE_TRAILING_STOP=True
ENABLE_BTC_DIRECTIONAL_FILTER=True
BTC_DIRECTION_EMA=200
ENABLE_RELATIVE_STRENGTH_FILTER=True
RS_LOOKBACK_PERIOD=14

ML_ENABLED=True
ML_AUTO_TRAIN_ENABLED=True
ML_RETRAIN_INTERVAL_HOURS=12

BINANCE_PROXY_URLS="http://user:password@64.137.96.74:6641,http://user:password@84.247.60.125:6095,http://user:password@45.38.107.97:6014"
BINANCE_PROXY_SIGNED_ONLY=True

TELEGRAM_BOT_TOKEN=your_telegram_bot_token
TELEGRAM_CHAT_ID=your_telegram_chat_id
ENABLE_PERIODIC_REPORTS=False

DASHBOARD_USERNAME=admin
DASHBOARD_PASSWORD=admin
SECRET_KEY=change_this_secret_key
